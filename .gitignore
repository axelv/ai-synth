__pycache__/
*.pyc
.venv/

# Rendered audio is reproducible from the patch it came with: patch.json regenerates
# render.wav to 1e-7 of loss. Committing 4.5 MB per render would put a permanent copy
# of every experiment in history for no information.
out/*.wav

# Faust probe fixtures for the abandoned differentiable surrogate. 182 MB, and
# faust_probe.py regenerates them on demand.
out/fixtures/
out/*.npz

# Analysis plots, regenerated by the script that drew them.
out/*.png
