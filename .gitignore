__pycache__/
*.pyc
.venv/

# Rendered audio is reproducible from the patch it came with: patch.json regenerates
# render.wav to 1e-7 of loss. Committing 4.5 MB per render would put a permanent copy
# of every experiment in history for no information.
out/*.wav

# Faust probe fixtures for the abandoned differentiable surrogate. 182 MB, and
# faust_probe.py regenerates them on demand.
out/fixtures/
out/*.npz

# Analysis plots, regenerated by the script that drew them.
out/*.png

# Claude Code worktrees are full checkouts of this repo, 3.9 GB of them. The config
# beside them is 12 KB and worth keeping.
.claude/worktrees/
# Per-machine: records which output style one person selected, not a project decision.
.claude/settings.local.json
.DS_Store

# out/ is where every experiment writes, and the debris of runs whose conclusions are
# already in CLAUDE.md is worth nothing: one patch_*.json and one log_*.txt per abandoned
# experiment. The frozen stage-1 inputs used to live here and now sit in data/ beside
# original.wav, which is the same category of thing. One file stays tracked:
#   patch.json  the incumbent, loss 1.544635, and the default --patch everywhere
out/*
!out/patch.json
